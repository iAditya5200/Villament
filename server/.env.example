# ------------------------------------------------------------------
# Villament server configuration
# Copy this file to ".env" (same folder) and fill in your own values.
# ------------------------------------------------------------------

# Port the Express API listens on
PORT=5000

# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/villament
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/villament
MONGODB_URI=mongodb://127.0.0.1:27017/villament

# Secret used to sign admin login tokens. Use a long random string in production.
JWT_SECRET=replace-this-with-a-long-random-secret

# How long an admin stays logged in before needing to log in again
JWT_EXPIRES_IN=1d

# The address of the React website (used for CORS). Comma-separate multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# First admin account, created by "npm run seed"
ADMIN_NAME=Villament Admin
ADMIN_EMAIL=admin@villament.com
ADMIN_PASSWORD=Admin@123
